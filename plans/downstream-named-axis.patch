+    """Recognize only #N/A from an active authored chart-suppression branch.
+
+    Missing/error-valued controls fail closed. An INDEX/MATCH #N/A in the
+    nonsuppressed branch is still unexpected, even in these same chart rows.
+    """
+    import re
+
+    if value != "#N/A":
+        return False
+    match = re.fullmatch(r"'Chart Data'!([D-X])(\d+)", address)
+    if match is None:
+        return False
+    row = int(match.group(2))
+    if row in _CHART_CUSTOM_EXTERNAL_ROWS:
+        return controls.get("'Customized Scenario-External'!D3") == "No"
+    if row in _CHART_CUSTOM_PUBLIC_ROWS:
+        return controls.get("'Customized Scenario - public'!C3") == "No"
+    base = _CHART_BOUND_ROWS.get(row)
+    if base is None:
+        return False
+    top = controls.get(f"'Chart Data'!AK{base}")
+    if type(top) not in (int, float):
+        return False
+    if top == 1:
+        return True
+    first = controls.get(f"'Chart Data'!AF{base}")
+    second = controls.get(f"'Chart Data'!AF{base + 3}")
+    if type(first) not in (int, float) or type(second) not in (int, float):
+        return False
+    return not (first > 0 and second == 1)
