+def test_graph_driver_evaluates_all_requested_cells_in_one_batch():
+    calls = []
+
+    def evaluate(targets):
+        calls.append(targets)
+        return {"M!A1": 12.0, "M!B1": "#N/A"}
+
+    driver = object.__new__(MvpGraphDriver)
+    driver._evaluator = SimpleNamespace(evaluate=evaluate)
+    assert driver.read_many(("M!A1", "M!B1")) == {"M!A1": 12.0, "M!B1": "#N/A"}
+    assert len(calls) == 1
+    assert tuple(calls[0]) == ("M!A1", "M!B1")
+
+
+def test_exported_library_oracle_batches_the_complete_output_request(monkeypatch):
+    calls = []
+    driver = SimpleNamespace(
+        reset_inputs=lambda: calls.append("reset"),
+        set_inputs=lambda values: calls.append(("set", values)),
+        read_many=lambda addresses: (
+            calls.append(addresses) or {"M!A1": 12.0, "M!B1": "#N/A"}
+        ),
+    )
+    oracle = object.__new__(harness.FormulaEvaluatorGraphOracle)
+    oracle._driver = driver
+    oracle._baselines_recorded = True
+    monkeypatch.setattr(harness, "inputs_for_excel", lambda scenario: {"M!C1": 2.0})
+    outputs = ("M!A1", "M!B1")
+    assert oracle(SimpleNamespace(id="batch"), outputs) == {
+        "M!A1": 12.0,
+        "M!B1": "#N/A",
+    }
+    assert calls == ["reset", ("set", {"M!C1": 2.0}), outputs]
+
