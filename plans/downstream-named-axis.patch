+"""Named-axis migration checks for authored workbook input contracts."""
+
+from pathlib import Path
+
+import pytest
+import yaml
+from excel_grapher.series_bindings.input_coerce import require_input_domain
+
+
+@pytest.mark.parametrize(
+    "filename,series_id,values",
+    [
+        ("input5.bindings.yaml", "input5_gfn_share", (0.0, 0.05, 0.2, 1.0)),
+        (
+            "inputs.bindings.yaml",
+            "input_1_rer_overvaluation",
+            (-100.0, -0.5, 20.0, 100.0),
+        ),
+    ],
+)
+def test_fractional_measures_accept_declared_float_values(
+    filename, series_id, values
+) -> None:
+    document = yaml.safe_load(Path("bindings", filename).read_text(encoding="utf-8"))
+    series = next(series for series in document["series"] if series["id"] == series_id)
+    require_input_domain(values, series["input"]["domain"], series_id=series_id)
+
+
+@pytest.mark.parametrize(
+    "series_id",
+    [
+        "input3_domestic_outstanding_of_existing_debt_in_lc",
+        "input3_domestic_o_w_st_lc_st",
+        "input3_domestic_outstanding_of_existing_debt_in_fx",
+        "input3_domestic_o_w_st_fc_st",
+        "input3_domestic_interest_payment_from_existing_debt_in_lc",
+        "input3_domestic_interest_payment_from_existing_debt_in_fx",
+        "input3_domestic_principal_payment_from_existing_debt_in_lc",
+        "input3_domestic_principal_payment_from_existing_debt_in_fx",
+    ],
+)
+def test_domestic_debt_measure_contract_preserves_numeric_values(series_id) -> None:
+    document = yaml.safe_load(
+        Path("bindings/inputs.bindings.yaml").read_text(encoding="utf-8")
+    )
+    series = next(series for series in document["series"] if series["id"] == series_id)
+    measure = series["structure"]["measure"]
+    assert measure["dtype"] == "float", (
+        "Debt values must remain numbers for workbook ISNUMBER guards"
+    )
+    assert measure["bind"]["read"] == "float"
+
+
+@pytest.mark.parametrize(
+    "filename,series_id",
+    [
+        ("constants.bindings.yaml", "imported_ppp_kppp"),
+        ("constants.bindings.yaml", "imported_ppp_ratio"),
+        ("constants.bindings.yaml", "data_rem_headers"),
+        ("constants.bindings.yaml", "data_rem_metadata"),
+        ("constants.bindings.yaml", "data_gdpusd_headers"),
+        ("constants.bindings.yaml", "data_gdpusd_metadata"),
+        (
+            "inputs.bindings.yaml",
+            "input3_input_3_macro_public_sector_liquid_assets_stock_e_g_cash_deposits_and_mar_2",
+        ),
+        ("internals-rest.bindings.yaml", "trigger_market_access"),
+        ("leftovers.bindings.yaml", "input6_tailored_params_fuel_label"),
+    ],
+)
+def test_mixed_workbook_measures_keep_numbers_and_text(filename, series_id) -> None:
+    document = yaml.safe_load(Path("bindings", filename).read_text(encoding="utf-8"))
+    series = next(series for series in document["series"] if series["id"] == series_id)
+    measure = series["structure"]["measure"]
+    assert measure["dtype"] == "float", (
+        "Numeric workbook values need the numeric/text measure union"
+    )
+    assert measure["bind"]["read"] == "auto"
+
+
+def test_liquid_asset_sentinel_is_preserved_by_binding_reader() -> None:
+    from excel_grapher.series_bindings.coerce import coerce_scalar
+
+    document = yaml.safe_load(
+        Path("bindings/inputs.bindings.yaml").read_text(encoding="utf-8")
+    )
+    series = next(
+        s
+        for s in document["series"]
+        if s["id"]
+        == "input3_input_3_macro_public_sector_liquid_assets_stock_e_g_cash_deposits_and_mar_2"
+    )
+    reader = series["structure"]["measure"]["bind"]["read"]
+    assert coerce_scalar("n.a.", reader) == "n.a."
+    assert coerce_scalar(8770.39094418668, reader) == 8770.39094418668
+
+
+@pytest.mark.parametrize(
+    "series_id",
+    [
+        "pv_stress_bounds_cumulative_selected_by_t_g_0",
+        "pv_stress_bounds_cumulative_selected_by_t_m_condition",
+        "pv_resfin_pub_output_cumulative_selected_by_t_g_0",
+        "pv_resfin_pub_output_cumulative_selected_by_t_m_condition",
+        "pv_resfin_add_output_cumulative_selected_by_t_g_0",
+        "pv_resfin_add_output_cumulative_selected_by_t_g_0_2",
+        "pv_resfin_add_output_cumulative_selected_by_t_m_condition",
+        "pv_resfin_add_output_cumulative_selected_by_t_m_condition_2",
+        "pv_baseline_com_discount_cumulative_selected_by_t_g_0",
+        "pv_baseline_com_discount_cumulative_selected_by_t_m_condition",
+        "pv_stress_com_discount_cumulative_selected_by_t_g_0",
+        "pv_stress_com_discount_cumulative_selected_by_t_m_condition",
+        "pv_stress_cumulative_selected_t_g_0",
+        "pv_stress_cumulative_selected_t_m_condition",
+    ],
+)
+def test_cumulative_monetary_measures_preserve_fractions(series_id) -> None:
+    from excel_grapher.series_bindings.coerce import coerce_scalar
+
+    document = yaml.safe_load(
+        Path("bindings/pv-stress.bindings.yaml").read_text(encoding="utf-8")
+    )
+    series = next(s for s in document["series"] if s["id"] == series_id)
+    measure = series["structure"]["measure"]
+    assert measure["dtype"] == "float", (
+        "Cumulative debt must preserve fractional monetary amounts"
+    )
+    assert coerce_scalar(298.604747533833, measure["bind"]["read"]) == 298.604747533833
+    year = next(
+        d for d in series["structure"]["dimensions"] if d["id"] == "TIME_PERIOD"
+    )
+    assert year["bind"]["read"] == "int", (
+        "Measure changes must preserve integer year readers"
+    )
+
+
+@pytest.mark.parametrize(
+    "series_id",
+    [
+        "in6opt_standard_one_time_30_percent_nominal_depreciation_of",
+        "in6opt_standard_size_of_fx_depreciation_shock",
+        "in6opt_standard_b6_combination_size_of_fx_depreciation_shock",
+    ],
+)
+def test_fx_depreciation_shock_rules_preserve_fractional_sizes(series_id) -> None:
+    from excel_grapher.series_bindings.coerce import coerce_scalar
+
+    document = yaml.safe_load(
+        Path("bindings/internals-rest.bindings.yaml").read_text(encoding="utf-8")
+    )
+    series = next(s for s in document["series"] if s["id"] == series_id)
+    measure = series["structure"]["measure"]
+    assert measure["dtype"] == "float", (
+        "FX shock formulas can produce fractional percentages"
+    )
+    assert (
+        coerce_scalar(39.278230749954716, measure["bind"]["read"]) == 39.278230749954716
+    )
