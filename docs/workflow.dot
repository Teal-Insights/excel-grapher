        excel_grapher_124 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD WIDTH="240" ALIGN="LEFT"><B>#124</B> · Follow-on: Audit edge/guard storage model and typed edge design</TD></TR></TABLE>>, URL="https://github.com/Teal-Insights/excel-grapher/issues/124", href="https://github.com/Teal-Insights/excel-grapher/issues/124", tooltip="#124 · Follow-on: Audit edge/guard storage model and typed edge design", target="_blank"];
