digraph workflow {
  graph [compound=true, rankdir=TB];
  node [shape=box, style="rounded", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];

  subgraph "cluster_repo_excel_grapher" {
    label="excel-grapher GitHub issues";

    excel_grapher_141 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD WIDTH="240" ALIGN="LEFT"><B>#141</B> · Create a process diagram that analyzes which gh issues have to be completed in sequence and which can be worked in parallel</TD></TR></TABLE>>, URL="https://github.com/Teal-Insights/excel-grapher/issues/141", href="https://github.com/Teal-Insights/excel-grapher/issues/141", tooltip="#141 · Create a process diagram that analyzes which gh issues have to be completed in sequence and which can be worked in parallel", target="_blank"];

    subgraph "cluster_repo_excel_grapher_major" {
      label="Major/ambitious new features";
      excel_grapher_6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD WIDTH="240" ALIGN="LEFT"><B>#6</B> · Potentially support VBA transpilation/translation?</TD></TR></TABLE>>, URL="https://github.com/Teal-Insights/excel-grapher/issues/6", href="https://github.com/Teal-Insights/excel-grapher/issues/6", tooltip="#6 · Potentially support VBA transpilation/translation?", target="_blank"];
