    subgraph "cluster_repo_excel_grapher_tests" {
      label="Test suite improvements";
      excel_grapher_17 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD WIDTH="240" ALIGN="LEFT"><B>#17</B> · Either prevent offset values from being perturbed, or add carveouts to perturb them only strategically</TD></TR></TABLE>>, URL="https://github.com/Teal-Insights/excel-grapher/issues/17", href="https://github.com/Teal-Insights/excel-grapher/issues/17", tooltip="#17 · Either prevent offset values from being perturbed, or add carveouts to perturb them only strategically", target="_blank"];
      excel_grapher_18 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD WIDTH="240" ALIGN="LEFT"><B>#18</B> · Do smarter input perturbation in the golden master test</TD></TR></TABLE>>, URL="https://github.com/Teal-Insights/excel-grapher/issues/18", href="https://github.com/Teal-Insights/excel-grapher/issues/18", tooltip="#18 · Do smarter input perturbation in the golden master test", target="_blank"];
      excel_grapher_25 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD WIDTH="240" ALIGN="LEFT"><B>#25</B> · Optimize/speed up graph extraction and Excel workbook operations for golden master testing</TD></TR></TABLE>>, URL="https://github.com/Teal-Insights/excel-grapher/issues/25", href="https://github.com/Teal-Insights/excel-grapher/issues/25", tooltip="#25 · Optimize/speed up graph extraction and Excel workbook operations for golden master testing", target="_blank"];
      excel_grapher_103 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD WIDTH="240" ALIGN="LEFT"><B>#103</B> · xlwings parity unit tests for runtime functions</TD></TR></TABLE>>, URL="https://github.com/Teal-Insights/excel-grapher/issues/103", href="https://github.com/Teal-Insights/excel-grapher/issues/103", tooltip="#103 · xlwings parity unit tests for runtime functions", target="_blank"];
      excel_grapher_139 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD WIDTH="240" ALIGN="LEFT"><B>#139</B> · Refactor/reorganize the integration test suite</TD></TR></TABLE>>, URL="https://github.com/Teal-Insights/excel-grapher/issues/139", href="https://github.com/Teal-Insights/excel-grapher/issues/139", tooltip="#139 · Refactor/reorganize the integration test suite", target="_blank"];
