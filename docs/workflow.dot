      subgraph "cluster_repo_excel_grapher_api_audit_dependency_graph_api_enhancements_minor" {
        label="Minor bug fixes and improvements";
        excel_grapher_130 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4" CELLSPACING="0"><TR><TD WIDTH="240" ALIGN="LEFT"><B>#130</B> · FormulaEvaluator: circular-reference warning emitted only once when cell is memoized</TD></TR></TABLE>>, URL="https://github.com/Teal-Insights/excel-grapher/issues/130", href="https://github.com/Teal-Insights/excel-grapher/issues/130", tooltip="#130 · FormulaEvaluator: circular-reference warning emitted only once when cell is memoized", target="_blank"];
